+        uint8_t ret = 0, fret = 0;
+        for (size_t i = 0; i < n; i++) {
+            const auto& in = instructions[i];
+            uint32_t w = flow_writes(in);
+            uint32_t fw = flow_fwrites(in);
+            ret |= (uint8_t)(((w >> 2) & 1) | (((w >> 3) & 1) << 1));
+            fret |= (uint8_t)(fw & 1);
+            if (!reached[i]) continue;
+            d |= flow_reads(in) & ARGSP & ~valid[i];
+            fd |= flow_freads(in) & FARGS & ~fvalid[i];
+            if (!in.hasDelaySlot() || i + 1 >= n) {
+                auto id = in.getUniqueId();
+                if (id == InstrId::cpu_syscall || id == InstrId::cpu_break) {
+                    sites[fi].push_back({valid[i], fvalid[i], -1});
+                }
+                continue;
+            }
+            uint32_t slot_valid = (valid[i] | w) & ARGSP;
+            uint32_t slot_fvalid = (fvalid[i] | fw) & FARGS;
+            d |= flow_reads(instructions[i + 1]) & ARGSP & ~slot_valid;
+            fd |= flow_freads(instructions[i + 1]) & FARGS & ~slot_fvalid;
+            uint32_t at_site = (slot_valid | flow_writes(instructions[i + 1])) & ARGSP;
+            uint32_t at_fsite = (slot_fvalid | flow_fwrites(instructions[i + 1])) & FARGS;
+            auto id = in.getUniqueId();
+            uint32_t target = (uint32_t)in.getBranchVramGeneric();
+            bool outside = target < func.vram || target >= func.vram + 4 * n;
+            if (id == InstrId::cpu_jal) {
+                sites[fi].push_back({at_site, at_fsite, callee_of(in), (uint32_t)in.getVram()});
+            } else if (id == InstrId::cpu_jalr || id == InstrId::cpu_bgezal || id == InstrId::cpu_bltzal) {
+                if (id == InstrId::cpu_jalr || outside) sites[fi].push_back({at_site, at_fsite, -1, (uint32_t)in.getVram()});
+            } else if (id == InstrId::cpu_jr) {
+                bool table = false;
+                for (const auto& jtbl : stats.jump_tables) table |= jtbl.jr_vram == in.getVram();
+                if (!table && (int)in.GetO32_rs() != 31) {
+                    sites[fi].push_back({at_site, at_fsite, -1, (uint32_t)in.getVram()});
+                }
+            } else if ((in.isBranch() || id == InstrId::cpu_j) && outside) {
+                sites[fi].push_back({at_site, at_fsite, callee_of(in), (uint32_t)in.getVram()});
+            }
+        }
+        // a branch or jump that ends the instructions without its delay slot: no edge, nothing called
+        direct[fi] = d;
+        fdirect[fi] = fd;
+        rl_ret_writes[fi] = ret;
+        rl_fret_writes[fi] = fret;
+        analysed[fi] = true;
+    }
+    for (size_t fi = 0; fi < nf; fi++) {
