+    // (or since its entry, when the locals were read from the context) and the callee may read them --
+    // what the old code, with the FPU registers in the context, left there. May-analysis, per call site
+    // (keyed by its delay slot's vram, where the code generator is when it emits the call).
+    size_t fsites = 0, fkept = 0;
+    for (size_t fi = 0; fi < nf; fi++) {
+        if (!analysed[fi]) continue;
+        const Function& func = context.functions[fi];
+        std::vector<rabbitizer::InstructionCpu> instructions;
+        instructions.reserve(func.words.size());
+        uint32_t vram = func.vram;
