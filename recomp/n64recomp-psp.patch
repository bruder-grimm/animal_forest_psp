+                            N64Recomp::Reloc hi_reloc = lo_reloc;
+                            hi_reloc.address = lui_addresses[rs];
+                            hi_reloc.type = N64Recomp::RelocType::R_MIPS_HI16;
+                            auto hi_find = hi_reloc_by_address.find(hi_reloc.address);
+                            if (hi_find != hi_reloc_by_address.end()) {
+                                kept_relocs[hi_find->second] = hi_reloc;
+                            }
+                            else {
+                                hi_reloc_by_address.emplace(hi_reloc.address, kept_relocs.size());
+                                kept_relocs.push_back(hi_reloc);
+                            }
+                        }
+                    }
+                    section_out.relocs = std::move(kept_relocs);
+                }
+                else {
