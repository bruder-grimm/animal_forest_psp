+// PSP fork: the control flow of a function's instructions, for the register_locals analyses below.
+// A branch or jump and its delay slot are one node; the slot's instruction is a node of its own too,
+// for when something branches to it. edges[i]: (successor, registers the edge adds, whether a call
+// returns on it). Branches and jumps out of the function have no edge.
+namespace {
+using InstrId = rabbitizer::InstrId::UniqueId;
+struct FlowEdge { size_t to; uint32_t add; bool call; };
+
+uint32_t flow_writes(const rabbitizer::InstructionCpu& in) {
+    uint32_t w = 0;
+    if (in.modifiesRd()) w |= 1u << (int)in.GetO32_rd();
+    if (in.modifiesRt()) w |= 1u << (int)in.GetO32_rt();
+    if (in.modifiesRs()) w |= 1u << (int)in.GetO32_rs();
+    if (in.doesLink()) w |= 1u << 31;
+    return w;
+}
+
+uint32_t flow_reads(const rabbitizer::InstructionCpu& in) {
+    uint32_t r = 0;
+    if (in.readsRs()) r |= 1u << (int)in.GetO32_rs();
+    if (in.readsRt()) r |= 1u << (int)in.GetO32_rt();
+    if (in.readsRd()) r |= 1u << (int)in.GetO32_rd();
+    return r & ~1u;
+}
+
+// FPU registers by pair (FR=0: an odd register is the high half of the even one below it); bit k = f(2k), f(2k+1).
+uint32_t flow_fwrites(const rabbitizer::InstructionCpu& in) {
+    uint32_t w = 0;
+    if (in.modifiesFd()) w |= 1u << ((int)in.GetO32_fd() >> 1);
+    if (in.modifiesFs()) w |= 1u << ((int)in.GetO32_fs() >> 1);
+    if (in.modifiesFt()) w |= 1u << ((int)in.GetO32_ft() >> 1);
+    return w;
+}
+
+uint32_t flow_freads(const rabbitizer::InstructionCpu& in) {
+    uint32_t r = 0;
+    if (in.readsFd()) r |= 1u << ((int)in.GetO32_fd() >> 1);
+    if (in.readsFs()) r |= 1u << ((int)in.GetO32_fs() >> 1);
+    if (in.readsFt()) r |= 1u << ((int)in.GetO32_ft() >> 1);
+    return r;
+}
+
+bool flow_is_call(const rabbitizer::InstructionCpu& in, int64_t target_index) {
+    auto id = in.getUniqueId();
+    return id == InstrId::cpu_jal || id == InstrId::cpu_jalr ||
+           ((id == InstrId::cpu_bgezal || id == InstrId::cpu_bltzal) && target_index < 0);
+}
+
+std::vector<std::vector<FlowEdge>> flow_edges(const N64Recomp::Function& func,
+                                              const std::vector<rabbitizer::InstructionCpu>& instructions,
+                                              const N64Recomp::FunctionStats& stats) {
+    size_t n = instructions.size();
+    auto index_of = [&](uint32_t vram) -> int64_t {
+        if (vram < func.vram || vram >= func.vram + 4 * n) {
+            return -1;
+        }
+        return (vram - func.vram) / 4;
+    };
+    std::vector<std::vector<FlowEdge>> edges(n);
+    for (size_t i = 0; i < n; i++) {
+        const auto& in = instructions[i];
+        auto id = in.getUniqueId();
+        if (!in.hasDelaySlot() || i + 1 >= n) {
+            if (i + 1 < n) edges[i].push_back({i + 1, 0, false});
+            continue;
+        }
+        uint32_t slot_w = flow_writes(instructions[i + 1]);
+        if (flow_is_call(in, index_of(in.getBranchVramGeneric()))) {
+            if (i + 2 < n) edges[i].push_back({i + 2, slot_w, true});
+        } else if (id == InstrId::cpu_jr) {
+            for (const auto& jtbl : stats.jump_tables) {
+                if (jtbl.jr_vram == in.getVram()) {
+                    for (uint32_t e : jtbl.entries) {
+                        int64_t t = index_of(e);
+                        if (t >= 0) edges[i].push_back({(size_t)t, slot_w, false});
+                    }
+                }
+            }
+        } else if (in.isBranch() || id == InstrId::cpu_j) {
+            int64_t t = index_of(in.getBranchVramGeneric());
+            if (t >= 0) edges[i].push_back({(size_t)t, slot_w, false});
+            bool unconditional = in.isUnconditionalBranch() || id == InstrId::cpu_j;
+            if (!unconditional && i + 2 < n) {
