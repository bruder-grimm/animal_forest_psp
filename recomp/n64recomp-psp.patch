+// PSP fork: with register_locals the generated code trusts the calling
+// convention. This flags the places in a function where it is not followed:
+// a read of a temporary (at, v0-v1, t0-t9) that nothing in the function wrote
+// first -- an input the caller left in a register the convention doesn't pass
+// -- and a read of a temporary or an argument register after a call that
+// nothing wrote since, other than the v0/v1 the callee returns. Must-written
+// dataflow over the function's instructions; delay slots run before their
+// branch takes effect, a likely branch's slot only on the taken path.
+static void check_calling_convention(const N64Recomp::Context& context, const N64Recomp::Function& func,
+                                     const std::vector<rabbitizer::InstructionCpu>& instructions,
+                                     const N64Recomp::FunctionStats& stats) {
+    const uint32_t TEMPS = (1u << 1) | (1u << 2) | (1u << 3) | (0xFFu << 8) | (1u << 24) | (1u << 25);
+    const uint32_t ARGS = 0xFu << 4;
+    const uint32_t ALL = 0xFFFFFFFFu;
+    size_t n = instructions.size();
+    if (n == 0) {
+        return;
+    }
+    auto edges = flow_edges(func, instructions, stats);
+    auto writes = flow_writes;
+    auto reads = flow_reads;
+    // in_valid[i]: registers certainly written (or passed in) on every path to i.
+    std::vector<uint32_t> in_valid(n, ALL);
+    std::vector<bool> reached(n, false);
+    in_valid[0] = ALL & ~TEMPS;
+    reached[0] = true;
+    std::vector<size_t> work{0};
+    while (!work.empty()) {
+        size_t i = work.back();
+        work.pop_back();
+        uint32_t out = in_valid[i] | writes(instructions[i]);
+        for (const FlowEdge& e : edges[i]) {
+            uint32_t v = out | e.add;
+            if (e.call) {
+                v = (v & ~(TEMPS | ARGS)) | (1u << 2) | (1u << 3);
+            }
+            uint32_t merged = reached[e.to] ? (in_valid[e.to] & v) : v;
+            if (!reached[e.to] || merged != in_valid[e.to]) {
+                reached[e.to] = true;
+                in_valid[e.to] = merged;
+                work.push_back(e.to);
+            }
+        }
+    }
+    auto report = [&](size_t i, uint32_t valid) {
+        uint32_t bad = reads(instructions[i]) & ~valid & (TEMPS | ARGS);
+        if (bad) {
+            fmt::print(stderr, "ABI: {} 0x{:08X} reads unset {:08X}: {}\n", func.name, instructions[i].getVram(), bad,
+                       instructions[i].disassemble(0));
+        }
+    };
+    for (size_t i = 0; i < n; i++) {
+        if (!reached[i]) continue;
+        report(i, in_valid[i]);
+        if (instructions[i].hasDelaySlot() && i + 1 < n) {
+            report(i + 1, in_valid[i] | writes(instructions[i]));
+        }
+    }
+}
