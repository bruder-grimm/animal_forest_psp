+        if (!analyze_function(context, func, instructions, stats)) continue;
+        size_t n = instructions.size();
+        auto edges = flow_edges(func, instructions, stats);
+        std::unordered_map<uint32_t, uint32_t> need_at; // call vram -> pairs the callee may read
+        for (const Site& st : sites[fi]) {
+            need_at[st.vram] = st.callee < 0 ? FARGS : ((uint32_t)rl_finputs[(size_t)st.callee] << 6);
+        }
+        std::vector<uint32_t> dirty(n, 0);
+        std::vector<bool> reached(n, false);
+        reached[0] = true;
+        std::vector<size_t> work{0};
+        while (!work.empty()) {
+            size_t i = work.back();
+            work.pop_back();
+            const auto& in = instructions[i];
+            uint32_t out = (dirty[i] | flow_fwrites(in)) & FARGS;
+            uint32_t slot_w = (in.hasDelaySlot() && i + 1 < n) ? (flow_fwrites(instructions[i + 1]) & FARGS) : 0;
+            for (const FlowEdge& e : edges[i]) {
+                uint32_t v = out | slot_w;
+                if (e.call) {
+                    auto it = need_at.find(in.getVram());
+                    uint32_t need = it != need_at.end() ? it->second : FARGS;
+                    v &= ~need; // written back at the call
+                }
+                if (!reached[e.to] || (dirty[e.to] | v) != dirty[e.to]) {
+                    reached[e.to] = true;
+                    dirty[e.to] |= v;
+                    work.push_back(e.to);
+                }
+            }
+        }
+        for (const Site& st : sites[fi]) {
+            int64_t i = ((int64_t)st.vram - (int64_t)func.vram) / 4;
+            if (i < 0 || (size_t)i >= n) continue;
+            uint32_t at = (dirty[i] | flow_fwrites(instructions[i])) & FARGS;
+            if (instructions[i].hasDelaySlot() && (size_t)i + 1 < n) at |= flow_fwrites(instructions[i + 1]) & FARGS;
+            uint32_t flush = at & need_at[st.vram];
+            rl_fflush[((uint64_t)fi << 32) | (st.vram + 4)] = (uint8_t)(flush >> 6);
+            fsites++;
+            fkept += __builtin_popcount(flush);
+        }
+    }
+    fmt::print("register flow: FPU argument pairs written back at {} of {} call-site slots\n", fkept, 2 * fsites);
+
+    size_t flushed = 0, full = 0;
+    for (size_t fi = 0; fi < nf; fi++) {
+        for (const Site& st : sites[fi]) {
+            uint32_t need = st.callee < 0 ? ARGSP : rl_inputs[(size_t)st.callee];
+            flushed += __builtin_popcount(need);
+            full += 5;
+        }
+    }
+    fmt::print("register flow: {} rounds, {} direct call sites resolved, {} not; {} of {} argument/sp write-backs kept\n",
+               rounds, known_sites, unknown_sites, flushed, full);
+}
